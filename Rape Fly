        local function startSpeedHold(button, amount)
            local holding = true
            task.spawn(function()
                task.wait(0.6)
                while holding and button:IsDescendantOf(game) do
                    local oldSpeed = flySpeed
                    setFlySpeed(flySpeed + amount)
                    if flySpeed == oldSpeed then break end
                    task.wait(0.08)
                end
            end)
            return function()
